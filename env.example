# ════════════════════════════════════════════════════════════════
# Tekoá-Hur Backend — Variables de entorno
# ════════════════════════════════════════════════════════════════
#  NUNCA subir este archivo al repositorio (.gitignore debe incluirlo)
#  Copiar este archivo como .env y completar los valores reales
# ════════════════════════════════════════════════════════════════

# ── Servidor ─────────────────────────────────────────────────────
PORT=3001

# ── Node environment (development | test | production) ───────────
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────────
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# Esta variable es usada por:
#   - config/database.js  (instancia de Sequelize del servidor)
#   - config/config.json  (sequelize-cli para migrations/seeders)
#   - models/index.js     (carga de modelos)
DATABASE_URL=postgres://postgres:xxxxx@localhost:5432/xxxxx

# Base de datos para tests (separada para no afectar datos reales)
DATABASE_URL_TEST=postgres://postgres:xxxxx@localhost:5432/xxxxx_test

# ── Seguridad — Session (Swagger UI) ────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=e564ght045f9a2e3bf40edf83373bk98h2a8481bbc0127754d4a264f63df7edd

# ── Seguridad — JWT ──────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=7c71c1bb786e08f989c5jut76d97664f885179b9895681496adb123e8b2b2d1a960884cbdfd5a74f96a3c88188ae79d033c76c5e1cfa32f38abd4f8d9375268d
JWT_EXPIRES=8h

# ── CORS ─────────────────────────────────────────────────────────
# URL del frontend (sin barra final)
FRONTEND_URL=http://localhost:3000

# ── QR ───────────────────────────────────────────────────────────
# Tiempo de validez del QR generado por el docente (en minutos)
DURACION_QR_MINUTOS=120

# ── Basic Auth (Swagger UI y compatibilidad con frontend legacy) ─
# Deben coincidir con NEXT_PUBLIC_BASIC_USER / NEXT_PUBLIC_BASIC_PASS del frontend
BASIC_USER=xxx
BASIC_PASS=xxxxxx

# ── SMTP variables para enviar correo de recuperación de contraseña ───────────────
# Password de cuenta: xxxxx (modificar para produccion)
# El password cd SMTP_PASS es de contraseña de aplicacion, no de la cuenta de email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xxxx@unahur.edu.ar
SMTP_PASS=ccvdgrshtgffefw 
SMTP_FROM="Tekoa xxxx@unahur.edu.ar"